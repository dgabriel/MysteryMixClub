      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mmc-agent-obs-prometheus"
          },
          "expr": "sum by (type, model) (increase({__name__=~\"claude_code_lines_of_code_count.*\", source=~\"$source\"}[$__rate_interval]))",
          "refId": "A",
