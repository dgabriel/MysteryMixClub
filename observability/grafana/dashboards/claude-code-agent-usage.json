      "type": "timeseries",
      "title": "Cost usage (USD) by model + agent.name",
      "description": "Cost metrics are approximations (Claude Code docs' own caveat); treat /cost and provider billing as ground truth. Same agent.name caveat as above applies to live data.",
      "datasource": {
        "type": "prometheus",
        "uid": "mmc-agent-obs-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 29
      },
      "fieldConfig": {
        "defaults": {
