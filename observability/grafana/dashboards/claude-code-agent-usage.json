      "type": "timeseries",
      "title": "Lines of code by type (added/removed), by model",
      "description": "claude_code.lines_of_code.count has no agent.name attribute upstream (per Claude Code OTel docs) -- only type (added/removed) and model.",
      "datasource": {
        "type": "prometheus",
        "uid": "mmc-agent-obs-prometheus"
      },
      "gridPos": {
        "h": 8,
