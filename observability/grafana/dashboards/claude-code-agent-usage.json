          },
          "expr": "sum by (model, agent_name) (increase({__name__=~\"claude_code_cost_usage.*\", source=~\"$source\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{model}} / {{agent_name}}"
        }
      ]
    },
    {
