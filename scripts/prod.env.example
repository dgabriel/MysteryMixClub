# Template for /etc/mysterymixclub/prod.env on the production Droplet.
# Copy to /etc/mysterymixclub/prod.env and fill in real values.
# NEVER commit the populated file — it holds live secrets.

# Async SQLAlchemy URL for the local production Postgres (created by
# bootstrap-droplet-prod.sh). The app also accepts a bare postgresql:// URL and
# normalizes it to the +asyncpg driver, but be explicit here.
DATABASE_URL=postgresql+asyncpg://mmc_prod:CHANGE_ME@localhost:5432/mysterymixclub_prod

# Gunicorn worker count (MYS-259). Read directly by the systemd unit
# (scripts/mysterymixclub-api-prod.service), NOT by the app itself — it's
# consumed as a shell-style env var in the unit's ExecStart, not through
# app/config.py. The unit defaults to 2 (sized for this droplet's 2 vCPUs —
# infra/terraform/envs/prod/terraform.tfvars) if this line stays commented
# out or absent. Only uncomment and set this if you resize the droplet or
# measure a different optimum.
#
# IMPORTANT: leave this commented out, don't set it to an empty value. An
# uncommented `GUNICORN_WORKERS=` with nothing after the `=` still counts as
# "set" to systemd's EnvironmentFile parser and would override the unit's
# default with an EMPTY string — gunicorn then fails to start at all
# (`argument -w/--workers: invalid int value: ''`). Either omit the line
# entirely or give it a real integer.
#
# Changing it needs a real `sudo systemctl restart mysterymixclub-api`, not
# just `reload` (SIGHUP tells the already-running gunicorn master to respawn
# workers with its existing config; it does not re-read this env file — only
# a fresh process start does that). deploy-prod.sh's normal reload will NOT
# pick up a change here.
# GUNICORN_WORKERS=2

# JWT signing key (read by the app as SECRET_KEY). Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# Use a DIFFERENT value than staging's — never share a signing key across envs.
SECRET_KEY=CHANGE_ME

# Email + music-link integrations. Set RESEND_API_KEY so magic-link sign-in
# emails are actually sent; leave it empty and links are only logged to the
# service journal (journalctl -u mysterymixclub-api), which is NOT an
# acceptable prod state — real users can't read the server journal.
RESEND_API_KEY=

# Staging email sink (see staging.env.example for the full explanation).
# ALWAYS false in production — real users must receive their own email, never
# a redirected copy.
EMAIL_REDIRECT_TO_TEST=false
EMAIL_TEST_RECIPIENT=

# Public waitlist (MYS-215, temporary pre-launch flow). When true, the login
# page and POST /waitlist accept join requests; when false (default), that
# route 404s and the frontend falls back to the "email us" copy.
WAITLIST_ENABLED=false

# YouTube Data API v3 key — resolves a song -> YouTube video id for the mystery-mix
# playlist link (MYS-78). Optional: leave empty and the playlist link is simply
# omitted. Song search and paste-link resolution use Deezer (keyless), no key needed.
YOUTUBE_API_KEY=

# Spotify per-user OAuth playlist creation (MYS-83). Optional: leave empty and
# the feature is hidden. SPOTIFY_REDIRECT_URI must match a redirect URI on the
# Spotify app and point at this API's /spotify/callback.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=

# Shared-account playlist generation (MYS-169) — see .env.example at repo root
# for the full explanation. UUID of the app user whose spotify_connections row
# is the dedicated MysteryMixClub Spotify account. Empty = feature hidden.
SPOTIFY_PLAYLIST_ACCOUNT_USER_ID=

# Apple Music (MYS-104/105/106/108). All three are required together — with any
# of them empty the Apple UI renders nothing at all and Apple links fall back to
# the keyless iTunes lookup, which is a normal, supported state.
#   TEAM_ID     — Apple Developer membership details page, 10 chars.
#   KEY_ID      — the 10 chars in the downloaded AuthKey_XXXXXXXXXX.p8 filename.
#   PRIVATE_KEY — the .p8 file's full PEM contents. In this file it must be ONE
#                 line: keep the quotes and use literal \n between PEM lines,
#                 e.g. "-----BEGIN PRIVATE KEY-----\nMIGT...\n-----END PRIVATE KEY-----"
#                 (the app un-escapes them — see apple_music_token.py).
# The .p8 download is one-time and non-recoverable; keep the original in a
# password manager. Never commit a populated copy of this file.
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY=

# Google Sign-In (MysteryMixClub-ali8, ADR 0007). Optional: leave empty and the
# Google button is hidden. GOOGLE_REDIRECT_URI must match a redirect URI on the
# Google OAuth client and point at this API's /auth/google/callback. Use a
# SEPARATE OAuth client from staging's — never share GOOGLE_CLIENT_SECRET
# across environments. See "Enabling Google Sign-In" in staging-setup.md; the
# process is identical, just against prod's env file and a prod-only redirect
# URI (https://mysterymixclub.com/api/v1/auth/google/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Marks this deployment as production (see backend/app/config.py) — this is
# what makes the refresh-token cookie Secure. Getting this wrong on prod means
# session cookies aren't marked Secure.
ENVIRONMENT=production

# Comma-separated CORS origins, plus the base URL used to build magic-link
# emails. The bare apex is canonical, matching technical-design.md §5's
# magic-link example; www 301-redirects to it (see
# nginx-mysterymixclub-prod.conf), so this must be the apex host, not www.
ALLOWED_ORIGINS=https://mysterymixclub.com
APP_BASE_URL=https://mysterymixclub.com

# Inbound mail forwarding (MYS-242). Resend Inbound's MX lives on the apex
# domain, which prod serves — set this once the webhook endpoint (POST
# /api/v1/webhooks/resend/inbound) is created in the Resend dashboard and it
# hands back a signing secret. Leave empty and the route 503s rather than
# silently accepting unverified requests.
RESEND_WEBHOOK_SECRET=
# Leave empty to use the default (mysterymixclubspotify@gmail.com).
INBOUND_EMAIL_FORWARD_TO=

# Frontend API base is NO LONGER read from this file (MYS-259): the frontend
# build now happens in CI (.github/workflows/deploy-prod.yml's build-frontend
# job on a hosted runner), not on this Droplet, so this env file is never
# sourced for the build anymore. Setting VITE_API_BASE_URL here has no effect.
# To change it, set the `VITE_API_BASE_URL` GitHub Actions *variable* (not a
# secret — it ends up in public JS) at the REPOSITORY level (Settings →
# Secrets and variables → Actions → Variables), not on the `production`
# environment — the job that consumes it has no `environment:` key, so an
# environment-scoped variable there would be invisible to it. Leaving it
# unset defaults to empty, i.e. same-origin (relative /api/v1/...) through
# nginx — the correct value today.
